// A schema written in JSON5: unquoted keys, single quotes, a hex number and trailing commas.
{
  $schema: 'https://json-schema.org/draft/2020-12/schema',
  type: 'object',
  properties: {
    x: { type: 'integer' },
    y: { type: 'integer' },
    label: { type: 'string', maxLength: 0x10 },
  },
  required: ['x', 'y'],
  additionalProperties: false,
}
