{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "contentMappers": [
    { "package": "motherload", "extensions": [".toml", ".yaml", ".yml", ".jsonc", ".json5", ".env", ".csv", ".tsv", ".txt", ".md"] }
  ],
  "include": ["main.ts"]
}
