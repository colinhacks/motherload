// Definitions for other schemas to refer to; this file's own root type is `unknown`.
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "place": {
      "type": "object",
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "manager": { "$ref": "../user.schema.jsonc" },
      },
      "required": ["city"],
      "additionalProperties": false,
    },
  },
}
