// An order's line, with no $schema of its own, so it is read in its root's draft. It refers back
// to the order, and to an anchor and a definition of its own.
{
  "type": "object",
  "properties": {
    "sku": { "$ref": "#/$defs/sku" },
    "qty": { "type": "integer", "minimum": 1 },
    "price": { "$ref": "#money" },
    "order": { "$ref": "../order.schema.jsonc" },
  },
  "required": ["sku", "qty"],
  "$defs": {
    "sku": { "type": "string", "pattern": "^[A-Z]{3}-\\d+$" },
    "money": { "$anchor": "money", "type": "number", "multipleOf": 0.01 },
  },
}
