// A 2020-12 schema across two files, for tests/json-schema.test.ts: tuples in `prefixItems`, a
// `$ref` beside other keywords, to an `$anchor` in the other file, `dependentRequired` and
// `dependentSchemas` on one property, and a definition named as the other file is.
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^o-" },
    "lines": { "type": "array", "items": { "$ref": "./parts/line.schema.jsonc" }, "minItems": 1 },
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "items": false },
    "tags": { "type": "array", "prefixItems": [{ "const": "first" }], "items": { "type": "string" } },
    "total": { "$ref": "./parts/line.schema.jsonc#money", "minimum": 0, "description": "In dollars." },
    "placed": { "type": "string", "format": "date-time" },
    "gift": { "type": "boolean" },
    "note": { "type": "string" },
    "code": { "$ref": "#/$defs/line" },
  },
  "required": ["id", "lines"],
  "dependentRequired": { "gift": ["note"] },
  "dependentSchemas": { "gift": { "properties": { "note": { "minLength": 3 } } }, "placed": { "required": ["total"] } },
  "$defs": { "line": { "type": "string", "maxLength": 4 } },
}
