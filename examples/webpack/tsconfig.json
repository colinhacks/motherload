{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "contentMappers": [
    { "package": "motherload", "extensions": [".toml", ".csv", ".md"] }
  ],
  "include": ["main.ts", "site.ts"]
}
