{
  "name": "@motherload/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Import a JSON Schema in a .schema.jsonc file as its TypeScript type and a validator compiled with ajv.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/motherload.git",
    "directory": "packages/schema"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./loader": "./src/loader.ts",
    "./register": "./src/register.ts",
    "./esbuild": "./src/esbuild.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": []
    }
  },
  "dependencies": {
    "@motherload/core": "0.0.0",
    "@motherload/jsonc": "0.0.0",
    "@motherload/json5": "0.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
