{
  "name": "@motherload/toml",
  "version": "0.0.0",
  "private": true,
  "description": "Import .toml files as typed modules: TOML 1.1, read with smol-toml.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/motherload.git",
    "directory": "packages/toml"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./loader": "./src/loader.ts",
    "./register": "./src/register.ts",
    "./esbuild": "./src/esbuild.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": []
    }
  },
  "dependencies": {
    "@motherload/core": "0.0.0",
    "smol-toml": "^1.9.0"
  }
}
