{
  "name": "@motherload/md",
  "version": "0.3.0",
  "private": true,
  "description": "Import .md files as their body and their typed YAML frontmatter.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/motherload.git",
    "directory": "packages/md"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./loader": "./src/loader.ts",
    "./register": "./src/register.ts",
    "./esbuild": "./src/esbuild.ts",
    "./webpack": "./src/webpack.ts",
    "./turbopack": "./src/turbopack.ts",
    "./vite": "./src/vite.ts",
    "./jest": "./src/jest.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": []
    }
  },
  "dependencies": {
    "@motherload/core": "0.3.0",
    "@motherload/yaml": "0.3.0"
  }
