{
  "name": "@motherload/jsonc",
  "version": "0.2.0",
  "private": true,
  "description": "Import .jsonc files, JSON with comments, as typed modules, read with jsonc-parser.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/motherload.git",
    "directory": "packages/jsonc"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./loader": "./src/loader.ts",
    "./register": "./src/register.ts",
    "./esbuild": "./src/esbuild.ts",
    "./webpack": "./src/webpack.ts",
    "./turbopack": "./src/turbopack.ts",
    "./vite": "./src/vite.ts",
    "./jest": "./src/jest.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": []
    }
  },
  "dependencies": {
    "@motherload/core": "0.2.0",
    "jsonc-parser": "^3.3.1"
  }
}
