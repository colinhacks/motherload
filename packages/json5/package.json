{
  "name": "@motherload/json5",
  "version": "0.0.1",
  "private": true,
  "description": "Import .json5 files as typed modules, read with the JSON5 project's own parser.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/motherload.git",
    "directory": "packages/json5"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./loader": "./src/loader.ts",
    "./register": "./src/register.ts",
    "./esbuild": "./src/esbuild.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": []
    }
  },
  "dependencies": {
    "@motherload/core": "0.0.1",
    "json5": "^2.2.3"
  }
}
