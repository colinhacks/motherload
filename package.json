{
  "name": "motherload",
  "version": "0.0.1",
  "private": true,
  "description": "Import data files (.toml, .yaml, .json5, .jsonc, .env, .csv, .tsv, .txt, .md) as typed modules, and .schema.jsonc as a type and a validator. TypeScript 7.1 content mappers.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/motherload.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./esbuild": "./src/esbuild.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": []
    }
  },
  "scripts": {
    "build": "nub scripts/build.ts",
    "check-dist": "nub scripts/check-dist.ts",
    "bump": "nub scripts/bump.ts",
    "typecheck": "tsc --noEmit && tsc -p lab/universal/app/tsconfig.json --noEmit --runExternalCode && tsc -p lab/basic/tsconfig.json --noEmit --runExternalCode && tsc -p lab/packages/tsconfig.json --noEmit --runExternalCode",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@motherload/core": "link:packages/core",
    "@motherload/csv": "link:packages/csv",
    "@motherload/env": "link:packages/env",
    "@motherload/json5": "link:packages/json5",
    "@motherload/jsonc": "link:packages/jsonc",
    "@motherload/md": "link:packages/md",
    "@motherload/schema": "link:packages/schema",
    "@motherload/toml": "link:packages/toml",
    "@motherload/txt": "link:packages/txt",
    "@motherload/yaml": "link:packages/yaml",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.3",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "motherload": "link:.",
    "typescript": "7.1.0-dev.20261002.1",
    "universal-toml": "link:lab/universal/plugin",
    "universal-toml-2": "link:lab/universal/plugin",
    "unplugin": "^3.4.0"
  }
}
